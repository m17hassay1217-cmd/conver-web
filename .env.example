# Optional public integration addresses. Never put private API credentials in VITE_*.
# HTTPS endpoint must validate + rate-limit server-side and return {"received":true}
# only after accepting the message. No endpoint means honest, unsent preview mode.
VITE_CONTACT_ENDPOINT=
VITE_BOOKING_URL=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_PHONE=

# Optional public Turnstile sitekey. Secret must only exist in the receiving backend.
VITE_TURNSTILE_SITE_KEY=
